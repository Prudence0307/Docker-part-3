@{ var role = Context.Session.GetString("Role"); var fullName = Context.Session.GetString("FullName"); }
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - RaceDay</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <header class="raceday-header">
    <span class="brand">RaceDay</span>
    <nav>
      <a href="/">Home</a>
      @if (role == null)
      {
        <text> | </text><a href="/Account/Login">Login</a>
        <text> | </text><a href="/Account/Register">Register</a>
      }
      else if (role == "Organiser")
      {
        <text> | </text><a href="/Organiser/Dashboard">Organiser Dashboard</a>
        <text> | </text><a href="/Organiser/CreateEvent">Create Event</a>
      }
      else
      {
        <text> | </text><a href="/Participant/MyEvents">My Events</a>
        <text> | </text><a href="/Participant/MyResults">My Results</a>
      }
      @if (role != null)
      {
        <text> | </text><span>@fullName (@role)</span>
        <text> | </text><a href="/Account/Logout">Logout</a>
      }
    </nav>
  </header>

  <main class="container py-4">
    @RenderBody()
  </main>

  <footer class="text-center text-muted py-3 border-top">&copy; RaceDay - PROG6212</footer>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
